<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - User Management</title>
    <style>
        /* ── Reset ── */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: sans-serif;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        /* ── Left Sidebar ── */
        .sidebar {
            width: 260px;
            background-color: #2c3e50;
            color: white;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
        }

        .sidebar h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 20px;
            color: #ecf0f1;
        }

        .sidebar ul {
            list-style: none;
            flex: 1;
        }

        .sidebar ul li a {
            display: block;
            padding: 15px 25px;
            color: #bdc3c7;
            text-decoration: none;
            font-size: 16px;
            border-left: 4px solid transparent;
            transition: all 0.2s ease;
        }

        .sidebar ul li a:hover,
        .sidebar ul li a.active {
            background-color: #34495e;
            color: white;
            border-left-color: #e74c3c;
        }

        .sidebar-footer {
            padding: 20px 25px;
            border-top: 1px solid #34495e;
        }

        .btn-logout {
            display: block;
            width: 100%;
            padding: 10px;
            background-color: transparent;
            color: #e74c3c;
            border: 2px solid #e74c3c;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            transition: all 0.2s ease;
        }

        .btn-logout:hover {
            background-color: #e74c3c;
            color: white;
        }

        /* ── Main Content ── */
        .main-content {
            flex: 1;
            background-color: #f8f9fa;
            padding: 30px;
        }

        /* ── Unified Admin Table ── */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: white;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        .admin-table th,
        .admin-table td {
            padding: 12px;
            text-align: left;
            border: 1px solid #e0e0e0;
        }

        .admin-table th {
            background-color: #f2f2f2;
            font-weight: bold;
            color: #333;
        }

        .id-cell {
            word-break: break-all;
            max-width: 180px;
            font-size: 13px;
            color: #555;
        }

        /* ── Role Badge ── */
        .role-badge {
            display: inline-block;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 20px;
            text-transform: capitalize;
        }

        .role-customer {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .role-admin {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        /* ── Fade-out Row Animation ── */
        .admin-table tr {
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .row-fade-out {
            opacity: 0;
            transform: translateX(-15px);
        }

        /* ── Delete Button ── */
        .btn-delete {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-delete:hover {
            background-color: #c0392b;
        }

        .btn-delete:active {
            transform: scale(0.96);
        }

        /* ── Dialog ── */
        dialog::backdrop {
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(3px);
        }

        dialog {
            border: none;
            border-radius: 8px;
            padding: 25px;
            width: 400px;
            margin: auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        dialog h3 {
            margin-bottom: 15px;
            font-size: 18px;
            color: #2c3e50;
        }

        dialog p {
            font-size: 14px;
            color: #555;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .dialog-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-secondary {
            background-color: #95a5a6;
            color: white;
            border: none;
            padding: 8px 15px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

        .btn-secondary:hover {
            background-color: #7f8c8d;
        }

        .btn-confirm-delete {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
            transition: background-color 0.2s ease;
        }

        .btn-confirm-delete:hover {
            background-color: #c0392b;
        }
    </style>

    <script>
        let rowToClose = null;

        function openConfirmModal(buttonElement) {
            rowToClose = buttonElement.closest("tr");
            const userId = rowToClose.querySelector('.user-id-cell').textContent.trim();

            document.getElementById('targetUserId').value = userId;
            document.getElementById('confirmDeleteModal').showModal();
        }

        function closeConfirmModal() {
            document.getElementById('confirmDeleteModal').close();
            rowToClose = null;
        }

        async function deleteUserAccount() {
            const uid= document.getElementById('targetUserId').value;

            try {
                const res = await fetch("/admin/users", {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uid, role: 'customer' })
                });

                const data = await res.json();

                if (!res.ok) {
                    alert(data.message || "Failed to delete user account!");
                    closeConfirmModal();
                    return;
                }

                closeConfirmModal();

                if (rowToClose) {
                    rowToClose.classList.add('row-fade-out');
                    setTimeout(() => rowToClose.remove(), 400);
                }

                alert(data.message || "Deleted user account successfully!");

            } catch (err) {
                console.error("Network Error:", err);
                alert("Connection failure error while trying to delete user account.");
                closeConfirmModal();
            }
        }
    </script>
</head>

<body>

    <div class="admin-container">

        <!-- ── Sidebar ── -->
        <aside class="sidebar">
            <h2>Dashboard</h2>
            <ul>
                <li><a href="/admin/dashboard">📊 Dashboard</a></li>
                <li><a href="/admin/users"      class="{{#if page.users}}active{{/if}}">👤 User Management</a></li>
                <li><a href="/admin/food-items" class="{{#if page.food}}active{{/if}}">🍔 Food Items</a></li>
                <li><a href="/admin/orders"     class="{{#if page.orders}}active{{/if}}">📦 Orders</a></li>
            </ul>
            <div class="sidebar-footer">
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn-logout">⏻ Logout</button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <h1>User Management</h1>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each users}}
                    <tr>
                        <td class="id-cell user-id-cell">{{this.uid}}</td>
                        <td>{{this.name}}</td>
                        <td>{{this.email}}</td>
                        <td>
                            <button type="button" class="btn-delete" onclick="openConfirmModal(this)">Delete Account</button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </main>
    </div>

    <!-- Confirm Delete Dialog -->
    <dialog id="confirmDeleteModal">
        <h3>Delete User Account</h3>
        <p>Are you sure you want to permanently delete this user? This action cannot be undone.</p>
        <input type="hidden" id="targetUserId">
        <div class="dialog-actions">
            <button type="button" class="btn-secondary" onclick="closeConfirmModal()">Cancel</button>
            <button type="button" class="btn-confirm-delete" onclick="deleteUserAccount()">Confirm Delete</button>
        </div>
    </dialog> 
    

</body>
</html>
