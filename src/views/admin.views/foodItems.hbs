<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
    <style>
        /* ── Reset ── */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: sans-serif;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        /* ── Left Sidebar ── */
        .sidebar {
            width: 260px;
            background-color: #2c3e50;
            color: white;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
        }

        .sidebar h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 20px;
            color: #ecf0f1;
        }

        .sidebar ul {
            list-style: none;
            flex: 1;
        }

        .sidebar ul li a {
            display: block;
            padding: 15px 25px;
            color: #bdc3c7;
            text-decoration: none;
            font-size: 16px;
            border-left: 4px solid transparent;
            transition: all 0.2s ease;
        }

        .sidebar ul li a:hover,
        .sidebar ul li a.active {
            background-color: #34495e;
            color: white;
            border-left-color: #e74c3c;
        }

        .sidebar-footer {
            padding: 20px 25px;
            border-top: 1px solid #34495e;
        }

        .btn-logout {
            display: block;
            width: 100%;
            padding: 10px;
            background-color: transparent;
            color: #e74c3c;
            border: 2px solid #e74c3c;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            transition: all 0.2s ease;
        }

        .btn-logout:hover {
            background-color: #e74c3c;
            color: white;
        }

        /* ── Main Content ── */
        .main-content {
            flex: 1;
            background-color: #f8f9fa;
            padding: 30px;
        }

        /* ── Unified Admin Table ── */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: white;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        .admin-table th,
        .admin-table td {
            padding: 12px;
            text-align: left;
            border: 1px solid #e0e0e0;
        }

        .admin-table th {
            background-color: #f2f2f2;
            font-weight: bold;
            color: #333;
        }

        .id-cell {
            word-break: break-all;
            max-width: 180px;
            font-size: 13px;
            color: #555;
        }

        /* ── Action Buttons ── */
        .action-group {
            display: flex;
            gap: 8px;
        }

       
        /* ── Add Button ── */
        .btn-add-container {
            margin-top: 20px;
            display: flex;
            justify-content: flex-end;
        }

        .btn-primary {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            transition: background-color 0.2s ease;
        }

        .btn-primary:hover {
            background-color: #27ae60;
        }

        /* ── Dialog ── */
        dialog::backdrop {
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(3px);
        }

        dialog {
            border: none;
            border-radius: 8px;
            padding: 25px;
            width: 400px;
            margin: auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        dialog h3 {
            margin-bottom: 15px;
            font-size: 18px;
            color: #2c3e50;
        }

        dialog p {
            font-size: 14px;
            color: #555;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
            font-weight: bold;
        }

        .form-group input {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .dialog-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-secondary {
            background-color: #95a5a6;
            color: white;
            border: none;
            padding: 8px 15px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

        .btn-secondary:hover {
            background-color: #7f8c8d;
        }

        .btn-confirm-delete {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
            transition: background-color 0.2s ease;
        }

        .btn-confirm-delete:hover {
            background-color: #c0392b;
        }

        .btn-confirm-edit {
            background-color: #3498db;
            color: white;
            border: none;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
            transition: background-color 0.2s ease;
        }

        .btn-confirm-edit:hover {
            background-color: #2980b9;
        }
    </style>

    <script>

        /* ── ADD MODAL ── */
        function openAddModal() {
            document.getElementById('addFoodModal').showModal();
        }

        function closeAddModal() {
            document.getElementById('addFoodForm').reset();
            document.getElementById('addFoodModal').close();
        }

        async function submitNewFoodItem(event) {
            event.preventDefault();

            const name = document.getElementById('foodName').value.trim();
            const price = parseFloat(document.getElementById('foodPrice').value);

            try {
                const res = await fetch("/food-items", {
                    method: "POST",
                    headers: { 'Content-Type': "application/json" },
                    body: JSON.stringify({ name, price })
                });

                const data = await res.json();

                if (!res.ok) {
                    alert(data.message || "Failed to add food item!");
                    return;
                }

                alert(data.message || "Food item added successfully!");
                closeAddModal();
                const tbody = document.querySelector('.admin-table tbody');
                const newRow = document.createElement('tr');
                newRow.innerHTML = `
                    <td class="id-cell food-id-cell">${data.createdFoodItem.fid}</td>
                    <td>${data.createdFoodItem.name}</td>
                    <td>Rs.${data.createdFoodItem.price}</td>
                    <td>
                        <div class="action-group">
                            <button class="btn-action btn-edit" onclick="openEditModal(this)">Edit</button>
                            <button class="btn-delete" onclick="openDeleteConfirmModal(this)">Delete</button>
                        </div>
                    </td>
                `;
                tbody.appendChild(newRow);

            } catch (err) {
                console.error("Submission Error:", err);
                alert("Network failure error while trying to add food item.");
            }
        }

        /* ── EDIT MODAL ── */
        let rowToEdit = null;

        function openEditModal(buttonElement) {
            rowToEdit = buttonElement.closest("tr");

            const foodItemId = rowToEdit.querySelector('.food-id-cell').textContent.trim();
            const currentName = rowToEdit.querySelectorAll('td')[1].textContent.trim();
            const currentPrice = rowToEdit.querySelectorAll('td')[2].textContent.replace('Rs.', '').trim();

            document.getElementById('editFoodItemId').value = foodItemId;
            document.getElementById('editFoodName').value = currentName;
            document.getElementById('editFoodPrice').value = currentPrice;

            document.getElementById('editFoodModal').showModal();
        }

        function closeEditModal() {
            document.getElementById('editFoodModal').close();
            document.getElementById('editFoodForm').reset();
            rowToEdit = null;
        }

        async function submitEditFoodItem(event) {
            event.preventDefault();

            const foodItemId = document.getElementById('editFoodItemId').value;
            const newName = document.getElementById('editFoodName').value.trim();
            const newPrice = parseFloat(document.getElementById('editFoodPrice').value);

            try {
                const res = await fetch(`/food-items/${foodItemId}`, {
                    method: "PATCH",
                    headers: { 'Content-Type': "application/json" },
                    body: JSON.stringify({ name: newName, price: newPrice })
                });

                const data = await res.json();

                if (!res.ok) {
                    alert(data.message || "Updating Food Item failed!");
                    closeEditModal();
                    return;
                }

                alert(data.message || "Updated successfully!");
                closeEditModal();
                window.location.reload();

            } catch (err) {
                console.error(err);
                alert(err.message);
                closeEditModal();
            }
        }

        /* ── DELETE MODAL ── */
        let rowToDelete = null;

        function openDeleteConfirmModal(buttonElement) {
            rowToDelete = buttonElement.closest("tr");
            const foodItemId = rowToDelete.querySelector('.food-id-cell').textContent.trim();

            document.getElementById('targetFoodItemId').value = foodItemId;
            document.getElementById('confirmDeleteModal').showModal();
        }

        function closeDeleteConfirmModal() {
            document.getElementById('confirmDeleteModal').close();
            rowToDelete = null;
        }

        async function deleteFoodItem() {
            const foodItemId = document.getElementById('targetFoodItemId').value;

            try {
                const res = await fetch(`/food-items/${foodItemId}`, {
                    method: "DELETE"
                });

                const data = await res.json();

                if (!res.ok) {
                    alert(data.message || "Food item deletion Failed!");
                    closeDeleteConfirmModal();
                    return;
                }

                closeDeleteConfirmModal();
                alert(data.message || "Deletion Successful!");
                window.location.reload();

            } catch (err) {
                console.error(err);
                alert(err.message);
                closeDeleteConfirmModal();
            }
        }
    </script>
</head>

<body>
    <div class="admin-container">

        <!-- ── Sidebar ── -->
        <aside class="sidebar">
            <h2>Dashboard</h2>
            <ul>
                <li><a href="/dashboard">📊 Dashboard</a></li>
                <li><a href="/users" class="{{#if page.users}}active{{/if}}">👤 User Management</a></li>
                <li><a href="/food-items" class="{{#if page.food}}active{{/if}}">🍔 Food Items</a></li>
                <li><a href="/orders" class="{{#if page.orders}}active{{/if}}">📦 Orders</a></li>
            </ul>
            <div class="sidebar-footer">
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn-logout">⏻ Logout</button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <h1>Food Items Menu</h1>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Item ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each foodItems}}
                    <tr>
                        <td class="id-cell food-id-cell">{{this.fid}}</td>
                        <td>{{this.name}}</td>
                        <td>Rs.{{this.price}}</td>
                        <td>
                            <div class="action-group">
                                <button class="btn-action btn-edit" onclick="openEditModal(this)">✏️</button>
                                <button class="btn-delete" onclick="openDeleteConfirmModal(this)">🗑️</button>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>

            <!-- Add Button -->
            <div class="btn-add-container">
                <button type="button" class="btn-primary" onclick="openAddModal()">+ Add New Food Item</button>
            </div>

            <!-- Add Food Item Dialog -->
            <dialog id="addFoodModal">
                <h3>Add New Food Item</h3>
                <form id="addFoodForm" onsubmit="submitNewFoodItem(event)">
                    <div class="form-group">
                        <label for="foodName">Item Name</label>
                        <input type="text" id="foodName" required placeholder="e.g., Pepperoni Pizza">
                    </div>
                    <div class="form-group">
                        <label for="foodPrice">Price (Rs.)</label>
                        <input type="number" id="foodPrice" step="0.01" required placeholder="e.g., 12.99">
                    </div>
                    <div class="dialog-actions">
                        <button type="button" class="btn-secondary" onclick="closeAddModal()">Cancel</button>
                        <button type="submit" class="btn-primary">Save Item</button>
                    </div>
                </form>
            </dialog>

        </main>
    </div>

    <!-- Confirm Delete Dialog -->
    <dialog id="confirmDeleteModal">
        <h3>Delete Food Item</h3>
        <p>Are you sure you want to permanently delete this food item? This action cannot be undone.</p>
        <input type="hidden" id="targetFoodItemId">
        <div class="dialog-actions">
            <button type="button" class="btn-secondary" onclick="closeDeleteConfirmModal()">Cancel</button>
            <button type="button" class="btn-confirm-delete" onclick="deleteFoodItem()">Confirm Delete</button>
        </div>
    </dialog>

    <!-- Edit Food Item Dialog -->
    <dialog id="editFoodModal">
        <h3>Edit Food Item</h3>
        <form id="editFoodForm" onsubmit="submitEditFoodItem(event)">
            <input type="hidden" id="editFoodItemId">
            <div class="form-group">
                <label for="editFoodName">Item Name</label>
                <input type="text" id="editFoodName" required placeholder="e.g., Pepperoni Pizza">
            </div>
            <div class="form-group">
                <label for="editFoodPrice">Price (Rs.)</label>
                <input type="number" id="editFoodPrice" step="0.01" required placeholder="e.g., 12.99">
            </div>
            <div class="dialog-actions">
                <button type="button" class="btn-secondary" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn-confirm-edit">Save Changes</button>
            </div>
        </form>
    </dialog>

</body>
</html>
